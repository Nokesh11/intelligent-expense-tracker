# NEVER commit real values here — this is just the template
# Copy this to .env and fill in your actual values

# Supabase (public — safe to expose to client)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Gemini API Key — SERVER SIDE ONLY (used in Edge Functions, never in the app)
# Do NOT prefix with EXPO_PUBLIC_ — this must stay server-side
GEMINI_API_KEY=your_gemini_api_key_here
